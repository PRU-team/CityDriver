# This .gitignore file is for Unity projects
# Get the latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]rojectSettings/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# [Aa]sset[Ss]tore/

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
# Rider cache directory
.idea/
*.sln
*.csproj
*.unityproj
*.sln.DotSettings
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.opendb.meta
*.VC.db.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/AddressableAssetsData/*/AssetBundles/

# Ignore Collaborate files
.collabignore

# Ignore PlasticSCM files
.plastic/

# Ignore JetBrains Rider project files
.idea/
*.sln.iml

# Ignore VS Code settings
.vscode/
